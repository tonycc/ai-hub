# Host-process local development only. Docker Compose uses the repository-root
# .env file and constructs container database URLs itself.
STANDALONE_ENVIRONMENT=local
STANDALONE_APPLICATION_ID=standalone-example
STANDALONE_PLATFORM_API_BASE_URL=http://platform.localhost:8088
STANDALONE_DATABASE_URL=postgresql+psycopg://standalone_app:local-only-standalone-password@localhost:5433/standalone_app_db
STANDALONE_OIDC_ISSUER=http://auth.localhost:8088/application/o/ai-hub/
STANDALONE_OIDC_AUDIENCE=ai-hub-platform
STANDALONE_OIDC_CLIENT_ID=ai-hub-platform
STANDALONE_OIDC_CLIENT_SECRET=local-only-oidc-client-secret
STANDALONE_OIDC_REDIRECT_URI=http://localhost:8100/auth/callback
STANDALONE_OIDC_JWKS_CACHE_TTL_SECONDS=300
STANDALONE_OIDC_JWKS_STALE_TTL_SECONDS=3600
STANDALONE_SESSION_SECRET=local-only-standalone-session-signing-secret
STANDALONE_AUTHORIZATION_CACHE_STALE_TTL_SECONDS=300
STANDALONE_INTEGRATION_CAPABILITIES=API_CLIENT

# Read only by the optional EVENT_PUBLISHER worker. Enable only after the
# publisher migration has been installed and the application capability registered.
STANDALONE_PUBLISHER_DATABASE_URL=postgresql+psycopg://standalone_outbox_publisher:local-only-standalone-publisher-password@localhost:5433/standalone_app_db
STANDALONE_RABBITMQ_URL=amqp://standalone_publisher:local-only-rabbitmq-publisher-password@localhost:5672/ai-hub-local
STANDALONE_EXCHANGE_NAME=ai-hub.events
STANDALONE_BATCH_SIZE=50
STANDALONE_MAX_ATTEMPTS=8
STANDALONE_RETRY_BASE_SECONDS=1
STANDALONE_RETRY_MAX_SECONDS=60
STANDALONE_LEASE_SECONDS=30

# Read only by the Alembic migration process.
STANDALONE_MIGRATION_DATABASE_URL=postgresql+psycopg://standalone_app_migrator:local-only-standalone-migrator-password@localhost:5433/standalone_app_db
