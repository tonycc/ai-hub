{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hub.example.internal/schemas/alert-rules.v1.json",
  "title": "AI Hub alert rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "source",
          "condition",
          "for_seconds",
          "route",
          "runbook"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "source": {
            "enum": [
              "platform_readiness",
              "http_probe",
              "operations_summary",
              "backup_freshness"
            ]
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator"],
            "properties": {
              "operator": { "enum": ["eq", "gt"] },
              "value": { "type": ["string", "number", "boolean"] },
              "target_path": { "type": "string", "pattern": "^(slo|recovery)\\." }
            },
            "oneOf": [
              { "required": ["value"], "not": { "required": ["target_path"] } },
              { "required": ["target_path"], "not": { "required": ["value"] } }
            ]
          },
          "path": { "type": "string", "pattern": "^/" },
          "for_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
          "route": { "type": "string", "minLength": 1 },
          "runbook": { "type": "string", "pattern": "^docs/runbooks/" }
        },
        "allOf": [
          {
            "if": { "properties": { "source": { "const": "http_probe" } } },
            "then": { "required": ["path"] }
          }
        ]
      }
    }
  }
}
