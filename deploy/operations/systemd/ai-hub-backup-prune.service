[Unit]
Description=Apply AI Hub verified-backup retention
After=ai-hub-backup.service

[Service]
Type=oneshot
User=ai-hub-operator
Group=ai-hub-operator
WorkingDirectory=/opt/ai-hub
UMask=0077
ExecStart=/opt/ai-hub/.venv/bin/ai-hub-backup prune --directory /mnt/ai-hub-off-host-backups --targets /opt/ai-hub/deploy/operations/production-targets.json --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/mnt/ai-hub-off-host-backups
