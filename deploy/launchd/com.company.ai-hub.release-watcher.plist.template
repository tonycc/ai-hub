<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.company.ai-hub.release-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DEPLOY_ROOT__/automation/watch-release.sh</string>
    <string>__DEPLOY_ROOT__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>93000300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__DEPLOY_ROOT__/logs/release-watcher.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__DEPLOY_ROOT__/logs/release-watcher.stderr.log</string>
</dict>
</plist>
