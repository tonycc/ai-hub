# LOCAL COMPOSE DEVELOPMENT ONLY.
# Copy this file to .env before running Docker Compose. Every password below is
# deliberately recognizable as local-only and must never be reused elsewhere.

# Deployment mode and service identity
AI_HUB_ENVIRONMENT=local
AI_HUB_APPLICATION_ID=ai-hub-platform
AI_HUB_OIDC_ISSUER=http://authentik:9000/application/o/ai-hub/
AI_HUB_OIDC_AUDIENCE=ai-hub-platform
STANDALONE_ENVIRONMENT=local
STANDALONE_APPLICATION_ID=standalone-example
STANDALONE_PLATFORM_API_BASE_URL=http://platform-api:8000

# Image and port controls
POSTGRES_IMAGE=postgres:18.4-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
PYTHON_IMAGE=python:3.14.7-slim@sha256:a7fb1e634c4a578f9e0bd6327f11a3cde11b7a9395f48e24360c0988bcc5c2bc
NODE_IMAGE=node:24.18.1-alpine@sha256:f70403e87646dc51b45295f4b8b70cdad0b63d2297c4c9899119b03f7af7a6b3
NGINX_IMAGE=nginx:1.30.4-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46
RABBITMQ_IMAGE=rabbitmq:4.2.9-management@sha256:a2751b3b5eed89e47ebbd5e776de0d6d85d924002773933ab881da49c073b85d
UV_VERSION=0.9.8
POSTGRES_DATA_VOLUME_TARGET=/var/lib/postgresql
AI_HUB_PLATFORM_IMAGE=ai-hub-platform
AI_HUB_PORTAL_IMAGE=ai-hub-portal
STANDALONE_APP_IMAGE=ai-hub-standalone-example
AI_HUB_IMAGE_TAG=local
AI_HUB_API_PORT=8000
AI_HUB_PORTAL_PORT=8080
STANDALONE_APP_PORT=8100

# Required local-only secrets. Compose refuses to start when any required
# value for the selected profile is missing or empty.
# Database role passwords are also embedded in connection URLs, so generated
# values must use URI-unreserved characters (A-Z, a-z, 0-9, dot, underscore,
# tilde, hyphen) with sufficient length; do not percent-encode them here.
POSTGRES_SUPERUSER_PASSWORD=local-only-postgres-admin-password
AUTHENTIK_DB_PASSWORD=local-only-authentik-password
AI_HUB_PLATFORM_MIGRATOR_DB_PASSWORD=local-only-platform-migrator-password
AI_HUB_PLATFORM_DB_PASSWORD=local-only-platform-password
AI_HUB_PROJECTION_MIGRATOR_DB_PASSWORD=local-only-projection-migrator-password
AI_HUB_PROJECTION_DB_PASSWORD=local-only-projection-password
STANDALONE_MIGRATOR_DB_PASSWORD=local-only-standalone-migrator-password
STANDALONE_APP_DB_PASSWORD=local-only-standalone-password
RABBITMQ_PASSWORD=local-only-rabbitmq-password
