# Host-process local development only. Docker Compose uses the repository-root
# .env file and constructs container database URLs itself.
AI_HUB_ENVIRONMENT=local
AI_HUB_APPLICATION_ID=ai-hub-platform
AI_HUB_DATABASE_URL=postgresql+psycopg://ai_hub_platform:local-only-platform-password@localhost:5433/platform_db
AI_HUB_OIDC_ISSUER=http://auth.localhost:8088/application/o/ai-hub/
AI_HUB_OIDC_AUDIENCE=ai-hub-platform
AI_HUB_OIDC_JWKS_CACHE_TTL_SECONDS=300
AI_HUB_OIDC_JWKS_STALE_TTL_SECONDS=3600
AI_HUB_AUTHORIZATION_CACHE_TTL_SECONDS=60
AI_HUB_OPERATIONS_RABBITMQ_MANAGEMENT_URL=http://localhost:15672
AI_HUB_OPERATIONS_RABBITMQ_VHOST=ai-hub-local
AI_HUB_OPERATIONS_RABBITMQ_USERNAME=platform_observer
AI_HUB_OPERATIONS_RABBITMQ_PASSWORD=local-only-rabbitmq-observer-password

# Read only by the optional platform projection Worker and its recovery commands.
AI_HUB_PROJECTION_DATABASE_URL=postgresql+psycopg://ai_hub_projection:local-only-projection-password@localhost:5433/platform_db
AI_HUB_RABBITMQ_URL=amqp://platform_projection:local-only-rabbitmq-projection-password@localhost:5672/ai-hub-local
AI_HUB_QUEUE_NAME=ai-hub.platform.projection
AI_HUB_PREFETCH_COUNT=20
AI_HUB_MAX_REDELIVERIES=5
AI_HUB_PROCESSING_DELAY_SECONDS=0
AI_HUB_ACKNOWLEDGEMENT_DELAY_SECONDS=0

# Read only by the corresponding Alembic migration process.
AI_HUB_MIGRATION_DATABASE_URL=postgresql+psycopg://ai_hub_platform_migrator:local-only-platform-migrator-password@localhost:5433/platform_db
AI_HUB_PROJECTION_MIGRATION_DATABASE_URL=postgresql+psycopg://ai_hub_projection_migrator:local-only-projection-migrator-password@localhost:5433/platform_db
