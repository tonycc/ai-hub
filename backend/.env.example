# Host-process local development only. Docker Compose uses the repository-root
# .env file and constructs container database URLs itself.
AI_HUB_ENVIRONMENT=local
AI_HUB_APPLICATION_ID=ai-hub-platform
AI_HUB_DATABASE_URL=postgresql+psycopg://ai_hub_platform:local-only-platform-password@localhost:5433/platform_db
AI_HUB_OIDC_ISSUER=http://auth.localhost:8088/application/o/ai-hub/
AI_HUB_OIDC_AUDIENCE=ai-hub-platform
AI_HUB_OIDC_JWKS_CACHE_TTL_SECONDS=300
AI_HUB_OIDC_JWKS_STALE_TTL_SECONDS=3600
AI_HUB_AUTHORIZATION_CACHE_TTL_SECONDS=60

# Read only by the corresponding Alembic migration process.
AI_HUB_MIGRATION_DATABASE_URL=postgresql+psycopg://ai_hub_platform_migrator:local-only-platform-migrator-password@localhost:5433/platform_db
AI_HUB_RAW_MIGRATION_DATABASE_URL=postgresql+psycopg://ai_hub_raw_migrator:local-only-raw-migrator-password@localhost:5433/platform_db

# Read only by the optional raw ingest worker (M7 scheduler).
AI_HUB_RAW_DATABASE_URL=postgresql+psycopg://ai_hub_raw:local-only-raw-password@localhost:5433/platform_db
AI_HUB_INGEST_SOURCES_PATH=deploy/operations/ingest-sources.json
AI_HUB_OIDC_CLIENT_ID=ai-hub-platform
AI_HUB_OIDC_CLIENT_SECRET=local-only-oidc-client-secret
