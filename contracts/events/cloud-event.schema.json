{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hub.example.internal/contracts/events/cloud-event.schema.json",
  "title": "AI Hub M2 Example Record CloudEvent",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "producer_application_id",
    "event_version",
    "aggregate_version",
    "source_sequence",
    "object_type",
    "trace_id",
    "actor",
    "data_classification",
    "data"
  ],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "source": {"const": "urn:ai-hub:application:standalone-example"},
    "type": {
      "enum": [
        "company.example.record.changed.v1",
        "company.example.record.deleted.v1"
      ]
    },
    "subject": {
      "type": "string",
      "pattern": "^example-record/[0-9a-fA-F-]{36}$"
    },
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {
      "const": "https://ai-hub.example.internal/contracts/events/example-record-event-data.v1.schema.json"
    },
    "producer_application_id": {"const": "standalone-example"},
    "event_version": {"const": 1},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "source_sequence": {"type": "integer", "minimum": 1},
    "object_type": {"const": "example_record"},
    "trace_id": {"type": ["string", "null"], "maxLength": 128},
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["user", "service", "system"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 255}
      },
      "additionalProperties": false
    },
    "data_classification": {"const": "internal"},
    "data": {
      "oneOf": [
        {"$ref": "./example-record-event-data.v1.schema.json#/$defs/changed"},
        {"$ref": "./example-record-event-data.v1.schema.json#/$defs/deleted"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "company.example.record.changed.v1"}}
      },
      "then": {"properties": {"data": {"$ref": "./example-record-event-data.v1.schema.json#/$defs/changed"}}}
    },
    {
      "if": {
        "properties": {"type": {"const": "company.example.record.deleted.v1"}}
      },
      "then": {"properties": {"data": {"$ref": "./example-record-event-data.v1.schema.json#/$defs/deleted"}}}
    }
  ],
  "additionalProperties": false
}
